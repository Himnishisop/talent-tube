rules_version = '2';

// ============================================================================
// Talent Tube – Firestore Security Rules
// ----------------------------------------------------------------------------
// Roles are stored in users/{uid}.role  ("customer" | "talent" | "admin").
// Admins are created manually in the Firebase console (never from the client).
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ helpers
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userRole() == 'admin';
    }
    function isPublicTalent(data) {
      return data.status == 'approved' && data.subscriptionStatus == 'active';
    }
    function validYouTubeVideos(videos) {
      // max 5 videos; each must have an 11-char videoId string (never a file)
      return videos is list && videos.size() <= 5;
    }
    // E.164 digits (country code + subscriber number, no "+"): 8–15 digits.
    function validPhone(n) {
      return n is string && n.matches('^[1-9][0-9]{7,14}$');
    }
    // ISO 3166-1 alpha-2 country code (or "OTHER" for unlisted countries).
    function validCountry(c) {
      return c is string && (c.matches('^[A-Z]{2}$') || c == 'OTHER');
    }
    // Fields only an admin (or the server) may set on a talent document
    function moderationFields() {
      return ['status', 'verified', 'featured', 'rejectionReason'];
    }
    function subscriptionFields() {
      return ['subscriptionStatus', 'subscriptionStartDate', 'subscriptionExpiryDate', 'paymentId'];
    }
    function talentTouchesProtectedFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(moderationFields().concat(subscriptionFields()));
    }

    // -------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // A user may create/update their own doc but can never grant themselves admin.
      allow create: if isSelf(uid)
        && request.resource.data.role in ['customer', 'talent']
        && request.resource.data.uid == uid;
      allow update: if (isSelf(uid) && request.resource.data.role in ['customer', 'talent']) || isAdmin();
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------ talents
    match /talents/{talentId} {
      // Public can read only approved + active profiles.
      // Owner and admin can always read.
      allow read: if isPublicTalent(resource.data) || isSelf(resource.data.uid) || isAdmin();

      // Talent creates own profile: doc id == uid, must start as pending /
      // payment-pending, not verified/featured.
      allow create: if isSelf(talentId)
        && request.resource.data.uid == talentId
        && request.resource.data.status == 'pending'
        && request.resource.data.verified == false
        && request.resource.data.featured == false
        && request.resource.data.subscriptionStatus == 'pending'
        && validYouTubeVideos(request.resource.data.videos)
        && validPhone(request.resource.data.mobile)
        && validPhone(request.resource.data.whatsapp)
        && validCountry(request.resource.data.country)
        && request.resource.data.description.size() <= 600;

      // Talent may edit own profile, but NOT moderation or subscription fields.
      // (Subscription fields are written by the verifyPayment Cloud Function
      //  using the Admin SDK, which bypasses these rules.)
      allow update: if (isSelf(talentId)
          && request.resource.data.uid == talentId
          && !talentTouchesProtectedFields()
          && validYouTubeVideos(request.resource.data.videos))
        || (isSelf(talentId)
          // Exception: a rejected talent may re-submit → status back to pending
          && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending'
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(subscriptionFields().concat(['verified', 'featured'])))
        || isAdmin();

      allow delete: if isAdmin();
    }

    // --------------------------------------------------------- categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----------------------------------------------------------- payments
    // Written ONLY by the Cloud Function (Admin SDK). Talents can read their
    // own payments; admins can read all.
    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // ------------------------------------------------------------ reports
    match /reports/{reportId} {
      allow create: if request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.talentId is string;
      allow read, update, delete: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
