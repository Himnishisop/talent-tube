# =============================================================================
# Talent Tube - Environment Variables Configuration
# Keep only essential APIs: MongoDB, Google Login, YouTube Data API v3
# =============================================================================

# 1. MongoDB (Database)
# Connection string from MongoDB Atlas (e.g., mongodb+srv://<user>:<password>@cluster.mongodb.net/talenttube?retryWrites=true&w=majority)
MONGODB_URI=

# 2. Google OAuth & YouTube Data API v3
# Obtain from Google Cloud Console -> APIs & Services -> Credentials (OAuth 2.0 Client ID)
# Used for BOTH "Sign in with Google" AND "YouTube Channel Connection / Uploads"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_DEFAULT_PRIVACY=unlisted

# 3. Cloudflare R2 (Object Storage for Profile Photos)
# Set up a bucket in Cloudflare Dashboard -> R2 Object Storage
# 1) Account ID: Copy from R2 Overview page (right sidebar)
# 2) API Tokens: Click "Manage R2 API Tokens" -> "Create API Token" (Permission: Object Read & Write)
# 3) Bucket Name: Your bucket name (e.g. talenttube)
# 4) Public URL (Optional): Enable "R2.dev subdomain" in bucket settings or connect a Custom Domain
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=talenttube
R2_PUBLIC_URL=

# 4. Session & Security
# Secret key used for signing JWT authentication tokens (any random 32+ character string)
JWT_SECRET=

# 4. Optional Admin Emails (comma-separated list of emails that automatically receive admin privileges)
ADMIN_EMAILS=admin@talenttube.in

# 5. Server & Host Configuration (defaults to port 3000 if not specified)
PORT=3000
SERVER_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# 6. Google Search Console Verification (Optional)
# If using HTML Tag method in Google Search Console, enter the verification content code here
# e.g., VITE_GOOGLE_SITE_VERIFICATION=google_verification_code_here
VITE_GOOGLE_SITE_VERIFICATION=

