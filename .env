# =============================================================================
# Talent Tube - Environment Variables Configuration
# =============================================================================

# 1. MongoDB (Database)
MONGODB_URI=

# 2. Google OAuth & YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_DEFAULT_PRIVACY=unlisted

# 3. Cloudflare R2 (Object Storage for Profile Photos)
# Cloudflare Dashboard -> R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=talenttube
R2_PUBLIC_URL=

# 4. Session & Security
JWT_SECRET=talenttube_secret_key_jwt_auth_production_2026

# 5. Admin & Host
ADMIN_EMAILS=musicallyhimnishverma@gmail.com,admin@talenttube.in
PORT=3000
SERVER_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# 6. Google Search Console Verification (Optional)
VITE_GOOGLE_SITE_VERIFICATION=

