rules_version = '2';

// Talent Tube – Firebase Storage rules.
// Storage is used ONLY for profile photos. Videos are never uploaded here;
// they are YouTube embeds.
service firebase.storage {
  match /b/{bucket}/o {
    match /profilePhotos/{uid}/{fileName} {
      // Anyone can view profile photos (they appear on public profiles)
      allow read: if true;
      // Only the owner can upload; images only; max 5 MB
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
